<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <UserSecretsId>ecm-webapi</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IBM.EntityFrameworkCore" Version="$(IbmEfCoreVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageReference Include="Serilog.AspNetCore" Version="$(SerilogAspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\1.1 Transversal\Itdear.Infraestructura.Seguridad\Itdear.Infraestructura.Seguridad.csproj" />
    <ProjectReference Include="..\..\1.1 Transversal\Itdear.ServiciosDistribuidos.WebApi.Core\Itdear.ServiciosDistribuidos.WebApi.Core.csproj" />
    <ProjectReference Include="..\..\1.3 Aplicacion\1.3.1 Servicios\ECM.Aplicacion.Servicios\ECM.Aplicacion.Servicios.csproj" />
    <ProjectReference Include="..\..\1.5 Infraestructura\ECM.Infraestructura.Datos\ECM.Infraestructura.Datos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Logs\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      El catalogo de plantillas de WhatsApp se edita en caliente desde el endpoint de
      administracion, por eso se copia solo si cambio: asi un despliegue no pisa los
      cambios hechos en el servidor.
    -->
    <None Update="Data\WhatsappTemplates.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
